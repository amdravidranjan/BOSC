<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional: lets the SDK read call state via TelephonyManager. Without it the SDK falls back to the audio mode. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Read the call-pressure score that the BOSC guardian app publishes. -->
    <uses-permission android:name="com.bosc.permission.READ_CALL_PRESSURE" />

    <queries>
        <!-- The BOSC guardian app (call-pressure score provider). -->
        <package android:name="com.bosc.guardian" />
        <!-- Remote-access / screen-sharing apps abused in refund and KYC scams.
             Confirm exact package names on a test phone before the demo. -->
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.rustdesk.rustdesk" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airdroidbiz" />
        <package android:name="com.sand.airmirror" />
        <package android:name="com.carriez.flutter_hbb" />
    </queries>
</manifest>
